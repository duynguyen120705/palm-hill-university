@model ChangePasswordVm
@{
    ViewData["Title"] = "Đổi mật khẩu";
}


<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm mt-2">
            <div class="card-body p-4">
                <h4 class="mb-3"><i class="bi bi-key me-2"></i>Đổi mật khẩu</h4>
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="MatKhauHienTai" class="form-label"></label>
                        <input asp-for="MatKhauHienTai" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="MatKhauHienTai" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MatKhauMoi" class="form-label"></label>
                        <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                        <div class="form-text">Tối thiểu 8 ký tự, gồm cả chữ và số, khác mật khẩu hiện tại.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="XacNhanMatKhauMoi" class="form-label"></label>
                        <input asp-for="XacNhanMatKhauMoi" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                        <a class="btn btn-outline-secondary" asp-action="Profile">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
