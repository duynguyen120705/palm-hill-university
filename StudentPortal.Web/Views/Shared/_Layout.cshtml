@{
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var vaiTro = new[] { Roles.Admin, Roles.CanBo, Roles.SinhVien }.FirstOrDefault(User.IsInRole);
    var khoa = User.FindFirst(AppClaimTypes.MaKhoaPhuTrach)?.Value;
    var nhanVaiTro = Roles.TenHienThi(vaiTro) + (khoa == null ? "" : " – " + khoa);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentPortal</title>
    @* Chỉ trang công khai mới có mô tả; các trang còn lại không cho lập chỉ mục *@
    @if (ViewData["MetaDescription"] is string moTa)
    {
        <meta name="description" content="@moTa" />
    }
    else
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentPortal.styles.css" asp-append-version="true" />
</head>
<body>
    @* Token anti-forgery để site.js gửi qua header RequestVerificationToken *@
    @Html.AntiForgeryToken()
    <header class="navbar navbar-light bg-white border-bottom box-shadow px-3">
        <div class="d-flex align-items-center">
            @if (daDangNhap)
            {
                <button class="navbar-toggler d-md-none me-2" type="button" data-bs-toggle="collapse" data-bs-target="#menuChinh"
                        aria-controls="menuChinh" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            }
            <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill me-1"></i>StudentPortal
            </a>
        </div>
        @if (daDangNhap)
        {
            <span class="small">@User.Identity!.Name (@nhanVaiTro)</span>
        }
    </header>
    <div class="d-md-flex">
        @if (daDangNhap)
        {
            <nav id="menuChinh" class="collapse d-md-block app-menu border-end bg-white p-3" aria-label="Menu chính">
                <partial name="_Menu" />
            </nav>
        }
        <main role="main" class="app-noi-dung flex-grow-1 p-3 p-md-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container text-center">
            &copy; 2026 - StudentPortal - Hệ thống Quản lý Sinh viên (Lập trình Web Nâng cao)
        </div>
    </footer>
    <partial name="_Modal" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
