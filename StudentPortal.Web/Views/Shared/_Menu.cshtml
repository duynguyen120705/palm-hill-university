@* Menu hiển thị theo vai trò (FR-08); quyền vẫn được kiểm tra lại tại server *@
<ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-door me-1"></i>Trang Chủ
        </a>
    </li>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.CanBo))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Students" asp-action="Index">
                <i class="bi bi-people-fill me-1"></i>Sinh Viên
            </a>
        </li>
    }
    @if (User.IsInRole(Roles.Admin))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">
                <i class="bi bi-people me-1"></i>Tài Khoản
            </a>
        </li>
    }
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.CanBo))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Statistics" asp-action="Index">
                <i class="bi bi-bar-chart-line me-1"></i>Thống Kê
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Import" asp-action="Index">
                <i class="bi bi-file-earmark-arrow-up me-1"></i>Nhập Excel
            </a>
        </li>
    }
</ul>
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Profile" title="Hồ sơ cá nhân">
                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="ChangePassword">
                <i class="bi bi-key me-1"></i>Đổi mật khẩu
            </a>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary mt-1">
                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
            </a>
        </li>
    }
</ul>
