@* Menu hiển thị theo vai trò (FR-08); quyền vẫn được kiểm tra lại tại server *@
@{
    var laCanBoTroLen = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.CanBo);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Lop(params string[] cacController) => cacController.Contains(controller) ? "nav-link active" : "nav-link text-dark";
    string LopTaiKhoan(string tenAction) => controller == "Account" && action == tenAction ? "nav-link active" : "nav-link text-dark";
}
<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <a class="@Lop("Home")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
    </li>
    @if (laCanBoTroLen)
    {
        <li class="nav-item">
            <a class="@Lop("Students")" asp-area="" asp-controller="Students" asp-action="Index"><i class="bi bi-people-fill me-2"></i>Sinh viên</a>
        </li>
        <li class="nav-item">
            <a class="@Lop("Statistics")" asp-area="" asp-controller="Statistics" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Thống kê</a>
        </li>
        <li class="nav-item">
            <a class="@Lop("Import")" asp-area="" asp-controller="Import" asp-action="Index"><i class="bi bi-file-earmark-arrow-up me-2"></i>Nhập Excel</a>
        </li>
        <li class="nav-item">
            <a class="@Lop("Faculties", "Courses", "Classes")" asp-area="" asp-controller="Faculties" asp-action="Index"><i class="bi bi-folder2-open me-2"></i>Danh mục</a>
        </li>
    }
    @if (User.IsInRole(Roles.Admin))
    {
        <li class="nav-item">
            <a class="@Lop("Users")" asp-area="" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-2"></i>Tài khoản</a>
        </li>
        <li class="nav-item">
            <a class="@Lop("AuditLogs")" asp-area="" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text me-2"></i>Nhật ký thao tác</a>
        </li>
    }
    <li class="nav-item">
        <a class="@LopTaiKhoan("Profile")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>Hồ sơ cá nhân</a>
    </li>
    <li class="nav-item">
        <a class="@LopTaiKhoan("ChangePassword")" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a>
    </li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link text-dark w-100 text-start border-0 bg-transparent"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
        </form>
    </li>
</ul>
