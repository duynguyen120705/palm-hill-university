@model StudentDetailVm
@* FR-14 Chi tiết hồ sơ: điểm bắt đầu của các thao tác FR-15 – FR-20 *@
@{
    ViewData["Title"] = "Chi tiết hồ sơ sinh viên";
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Hồ sơ sinh viên <span data-field="maSV"></span></h4>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-primary" id="btnSua"><i class="bi bi-pencil me-1"></i>Sửa</button>
    <button type="button" class="btn btn-outline-primary" id="btnDoiTrangThai"><i class="bi bi-arrow-repeat me-1"></i>Đổi trạng thái</button>
    <button type="button" class="btn btn-outline-primary" id="btnChuyenLop"><i class="bi bi-arrow-left-right me-1"></i>Chuyển lớp</button>
    <button type="button" class="btn btn-outline-warning" id="btnCapLaiMK"><i class="bi bi-key me-1"></i>Cấp lại mật khẩu</button>
    <button type="button" class="btn btn-outline-danger" id="btnKhoa"><i class="bi bi-lock me-1"></i>Khóa</button>
    <button type="button" class="btn btn-outline-success" id="btnMoKhoa"><i class="bi bi-unlock me-1"></i>Mở khóa</button>
    <button type="button" class="btn btn-danger ms-md-auto" id="btnXoa"><i class="bi bi-trash me-1"></i>Xóa</button>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Thông tin cá nhân</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Họ và tên</dt><dd class="col-7" data-field="hoTen"></dd>
                    <dt class="col-5">Ngày sinh</dt><dd class="col-7" data-field="ngaySinhFormatted"></dd>
                    <dt class="col-5">Giới tính</dt><dd class="col-7" data-field="gioiTinhText"></dd>
                    <dt class="col-5">Số điện thoại</dt><dd class="col-7" data-field="sdt"></dd>
                    <dt class="col-5">Email</dt><dd class="col-7 text-break" data-field="email"></dd>
                    <dt class="col-5">Địa chỉ</dt><dd class="col-7" data-field="diaChi"></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Thông tin học tập và tài khoản</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Lớp</dt><dd class="col-7"><span data-field="tenLop"></span> (<span data-field="maLop"></span>)</dd>
                    <dt class="col-5">Khoa</dt><dd class="col-7" data-field="tenKhoa"></dd>
                    <dt class="col-5">Khóa</dt><dd class="col-7" data-field="maKhoaHoc"></dd>
                    <dt class="col-5">Trạng thái học tập</dt><dd class="col-7" data-field="trangThaiText"></dd>
                    <dt class="col-5">Trạng thái tài khoản</dt><dd class="col-7" data-field="trangThaiTaiKhoanText"></dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<partial name="_StudentEditModal" model="new StudentEditVm()" />

@* FR-16 *@
<div class="modal fade" id="modalTrangThai" tabindex="-1" aria-labelledby="modalTrangThaiTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form id="formTrangThai" class="modal-content" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="modalTrangThaiTitle">Đổi trạng thái học tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none loi-modal" role="alert"></div>
                <div class="mb-3">
                    <label for="ttMoi" class="form-label">Trạng thái mới</label>
                    <select id="ttMoi" class="form-select" required></select>
                </div>
                <div>
                    <label for="ttLyDo" class="form-label">Lý do hoặc số quyết định <span id="ttBatBuoc" class="text-danger d-none">(bắt buộc)</span></label>
                    <input type="text" id="ttLyDo" class="form-control" maxlength="255" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

@* FR-17 *@
<div class="modal fade" id="modalChuyenLop" tabindex="-1" aria-labelledby="modalChuyenLopTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form id="formChuyenLop" class="modal-content" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="modalChuyenLopTitle">Chuyển lớp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none loi-modal" role="alert"></div>
                <div class="mb-3">
                    <label for="clLop" class="form-label">Lớp đích</label>
                    <select id="clLop" class="form-select" required></select>
                </div>
                <div>
                    <label for="clLyDo" class="form-label">Lý do (không bắt buộc)</label>
                    <input type="text" id="clLyDo" class="form-control" maxlength="255" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

@* FR-19 *@
<div class="modal fade" id="modalMatKhau" tabindex="-1" aria-labelledby="modalMatKhauTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form id="formMatKhau" class="modal-content" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="modalMatKhauTitle">Cấp lại mật khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none loi-modal" role="alert"></div>
                <div class="mb-3">
                    <label for="mkMoi" class="form-label">Mật khẩu mới</label>
                    <input type="password" id="mkMoi" class="form-control" autocomplete="new-password" required />
                    <div class="form-text">Tối thiểu 8 ký tự, gồm cả chữ và số.</div>
                </div>
                <div>
                    <label for="mkXacNhan" class="form-label">Xác nhận mật khẩu mới</label>
                    <input type="password" id="mkXacNhan" class="form-control" autocomplete="new-password" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>
</div>

@* FR-18 xóa mềm và FR-20 khóa/mở khóa: xác nhận kèm lý do bắt buộc *@
<div class="modal fade" id="modalLyDo" tabindex="-1" aria-labelledby="modalLyDoTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form id="formLyDo" class="modal-content" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="modalLyDoTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none loi-modal" role="alert"></div>
                <label for="ldNoiDung" class="form-label">Lý do (bắt buộc)</label>
                <input type="text" id="ldNoiDung" class="form-control" required />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" id="ldXacNhan" class="btn btn-danger">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

<script type="application/json" id="svData">@Json.Serialize(Model)</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/student-details.js" asp-append-version="true"></script>
}
