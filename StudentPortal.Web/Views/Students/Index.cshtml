@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Danh sách sinh viên</h4>
    <button type="button" id="btnThemSV" class="btn btn-primary app-nut-chinh"><i class="bi bi-plus-lg me-1"></i>Thêm SV</button>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form id="formDanhSach" class="row g-2 align-items-end">
            <div class="col-12">
                <label for="txtKeyword" class="form-label">Tìm kiếm</label>
                <input type="search" id="txtKeyword" name="keyword" class="form-control" maxlength="100"
                       placeholder="Nhập tên hoặc mã sinh viên (không cần dấu, VD: nguyen)" autocomplete="off" />
            </div>
            <div class="col-12 col-md-3">
                <label for="selKhoa" class="form-label">Khoa</label>
                <select id="selKhoa" name="maKhoa" class="form-select"><option value="">Tất cả</option></select>
            </div>
            <div class="col-12 col-md-3">
                <label for="selKhoaHoc" class="form-label">Khóa</label>
                <select id="selKhoaHoc" name="maKhoaHoc" class="form-select"><option value="">Tất cả</option></select>
            </div>
            <div class="col-12 col-md-3">
                <label for="selLop" class="form-label">Lớp</label>
                <select id="selLop" name="maLop" class="form-select"><option value="">Tất cả</option></select>
            </div>
            <div class="col-12 col-md-3">
                <label for="selTrangThai" class="form-label">Trạng thái</label>
                <select id="selTrangThai" name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="1">Đang học</option>
                    <option value="2">Bảo lưu</option>
                    <option value="4">Thôi học</option>
                    <option value="3">Đã tốt nghiệp</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
    <span id="dsStatus" class="small text-muted" aria-live="polite"></span>
    <div class="btn-group">
        <button type="button" id="btnXuatExcel" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</button>
        <button type="button" id="btnXuatPdf" class="btn btn-sm btn-danger"><i class="bi bi-file-earmark-pdf me-1"></i>Xuất PDF</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã SV</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Lớp</th>
                    <th>Trạng thái</th>
                    <th>Tài khoản</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody id="dsBody"></tbody>
        </table>
    </div>
    <nav class="card-footer bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center" aria-label="Phân trang danh sách">
        <span id="dsTotal" class="fw-semibold"></span>
        <partial name="_Pagination" model='"dsPaging"' />
    </nav>
</div>

<partial name="_StudentCreateModal" model="new StudentCreateVm()" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/students.js" asp-append-version="true"></script>
}
