@model StudentCreateVm
@* FR-13 Thêm hồ sơ sinh viên theo phiếu BM01 *@

<div class="modal fade" id="modalThemSV" tabindex="-1" aria-labelledby="modalThemSVTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form id="formThemSV" class="modal-content" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="modalThemSVTitle">Thêm hồ sơ sinh viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none loi-modal" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="MaSV" class="form-label"></label>
                        <input asp-for="MaSV" class="form-control" maxlength="15" />
                        <span asp-validation-for="MaSV" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HoTen" class="form-label"></label>
                        <input asp-for="HoTen" class="form-control" maxlength="100" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NgaySinh" class="form-label"></label>
                        <input asp-for="NgaySinh" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="GioiTinh" class="form-label"></label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="">-- Chọn --</option>
                            <option value="1">Nam</option>
                            <option value="2">Nữ</option>
                            <option value="3">Khác</option>
                        </select>
                        <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="csKhoa" class="form-label">Khoa</label>
                        <select id="csKhoa" class="form-select"><option value="">Tất cả</option></select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="csKhoaHoc" class="form-label">Khóa</label>
                        <select id="csKhoaHoc" class="form-select"><option value="">Tất cả</option></select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="MaLop" class="form-label"></label>
                        <select asp-for="MaLop" class="form-select"><option value="">-- Chọn lớp --</option></select>
                        <span asp-validation-for="MaLop" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="TrangThai" class="form-label"></label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="1">Đang học</option>
                            <option value="2">Bảo lưu</option>
                            <option value="3">Đã tốt nghiệp</option>
                            <option value="4">Thôi học</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="SDT" class="form-label"></label>
                        <input asp-for="SDT" class="form-control" maxlength="10" />
                        <span asp-validation-for="SDT" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" maxlength="100" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="DiaChi" class="form-label"></label>
                        <input asp-for="DiaChi" class="form-control" maxlength="255" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        <div class="form-text">Tên đăng nhập trùng với Mã sinh viên.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>
</div>
