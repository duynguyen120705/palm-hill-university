@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@Html.AntiForgeryToken()

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm mt-2">
            <div class="card-body p-4">
                <h4 class="mb-3"><i class="bi bi-key me-2"></i>Đổi mật khẩu</h4>
                <div id="mkMessage" class="alert d-none" role="status"></div>
                <form id="formDoiMatKhau" novalidate>
                    <div class="mb-3">
                        <label for="mkHienTai" class="form-label">Mật khẩu hiện tại</label>
                        <input type="password" id="mkHienTai" class="form-control" autocomplete="current-password" required />
                    </div>
                    <div class="mb-3">
                        <label for="mkMoi" class="form-label">Mật khẩu mới</label>
                        <input type="password" id="mkMoi" class="form-control" autocomplete="new-password" required />
                        <div class="form-text">Tối thiểu 8 ký tự, gồm cả chữ và số, khác mật khẩu hiện tại.</div>
                    </div>
                    <div class="mb-3">
                        <label for="mkXacNhan" class="form-label">Xác nhận mật khẩu mới</label>
                        <input type="password" id="mkXacNhan" class="form-control" autocomplete="new-password" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/hoso.js" asp-append-version="true"></script>
}
