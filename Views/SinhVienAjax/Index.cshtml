@{
    ViewData["Title"] = "Thực hành AJAX - Quản lý Sinh viên";
}

<div class="container-fluid py-3">
    <!-- Header Banner -->
    <div class="card shadow-sm border-0 mb-4 bg-primary text-white">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-1"><i class="bi bi-cpu"></i> Thực hành Tích hợp AJAX – ASP.NET Core MVC</h2>
                    <p class="mb-0 opacity-75">Môn học: Lập trình Web Nâng cao | Đề tài BTL: Hệ thống Quản lý Sinh viên (Student Portal)</p>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-light text-primary fs-6 px-3 py-2"><i class="bi bi-code-slash"></i> XMLHttpRequest</span>
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-filetype-json"></i> jQuery AJAX</span>
                    <span class="badge bg-success text-white fs-6 px-3 py-2"><i class="bi bi-lightning-charge"></i> Fetch API</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert / Toast Container -->
    <div id="liveAlertContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

    <!-- Live Execution Status Bar -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted" id="ajaxStatusIndicator">
                <span class="spinner-grow spinner-grow-sm text-success me-1 d-none" id="globalLoadingSpinner"></span>
                <strong>Trạng thái AJAX:</strong> <span id="ajaxStatusText" class="text-secondary">Sẵn sàng thực thi</span>
            </div>
            <div class="small">
                <span class="me-3">Phương thức hiện tại: <strong id="lblCurrentMethod" class="badge bg-info text-dark">XMLHttpRequest</strong></span>
                <span>Tổng số bản ghi: <strong id="lblTotalRecords" class="badge bg-secondary">0</strong></span>
            </div>
        </div>
    </div>

    <!-- Action & Filter Toolbar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <!-- Search Box (Fetch API + Debounce) -->
                <div class="col-md-5 col-lg-4">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="bi bi-search"></i> Tìm kiếm tức thì (Fetch API + Debounce 300ms):
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" id="txtKeywordSearch" class="form-control" placeholder="Nhập Mã SV, Họ tên, Email..." autocomplete="off" />
                        <button class="btn btn-outline-secondary" type="button" id="btnClearSearch" title="Xóa tìm kiếm">&times;</button>
                    </div>
                </div>

                <!-- Class Filter -->
                <div class="col-md-3 col-lg-3">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="bi bi-funnel"></i> Lọc theo Lớp:
                    </label>
                    <select id="selFilterLop" class="form-select">
                        <option value="">-- Tất cả các lớp --</option>
                    </select>
                </div>

                <!-- Page Size Selector -->
                <div class="col-md-2 col-lg-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Bản ghi/trang:</label>
                    <select id="selPageSize" class="form-select">
                        <option value="10" selected>10 sinh viên</option>
                        <option value="20">20 sinh viên</option>
                        <option value="50">50 sinh viên</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="col-md-12 col-lg-3 text-lg-end d-flex gap-2 justify-content-lg-end mt-lg-4">
                    <button class="btn btn-outline-primary" id="btnReloadXHR" title="Tải lại bằng XMLHttpRequest thuần">
                        <i class="bi bi-arrow-clockwise"></i> Load bằng XHR
                    </button>
                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCreateStudent">
                        <i class="bi bi-plus-circle"></i> Thêm mới (jQuery)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>Danh Sách Sinh Viên (Dữ liệu nạp động qua AJAX)
            </h5>
            <small class="text-muted" id="lblPaginationSummary">Đang tải...</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tblStudents">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 130px;">Mã SV</th>
                            <th style="min-width: 180px;">Họ và Tên</th>
                            <th style="width: 120px;">Ngày Sinh</th>
                            <th style="width: 100px;">Giới Tính</th>
                            <th style="min-width: 160px;">Lớp Học</th>
                            <th style="min-width: 180px;">Liên Hệ</th>
                            <th style="width: 130px;">Trạng Thái</th>
                            <th class="text-center pe-3" style="width: 100px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody">
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="spinner-border text-primary spinner-border-sm me-2"></div>
                                Đang khởi tạo dữ liệu qua XMLHttpRequest...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="text-muted small" id="lblPagingInfo">
                Hiển thị trang 1
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0" id="paginationContainer">
                    <!-- Pagination dynamically rendered -->
                </ul>
            </nav>
        </div>
    </div>

    <!-- Activity Log / Technical Flow Explanation Container -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <span class="small fw-semibold"><i class="bi bi-terminal me-1"></i> Nhật Ký Luồng AJAX Thời Gian Thực (Client-Side Audit Log)</span>
            <button class="btn btn-sm btn-outline-light py-0 px-2" id="btnClearLog" style="font-size: 0.75rem;">Xóa Log</button>
        </div>
        <div class="card-body bg-dark text-light p-3" style="font-family: Consolas, monospace; font-size: 0.85rem; max-height: 160px; overflow-y: auto;" id="ajaxLogTerminal">
            <div class="text-info">[HỆ THỐNG] Đã sẵn sàng nạp giao diện AJAX. Đang gọi XMLHttpRequest nạp trang 1...</div>
        </div>
    </div>
</div>

<!-- Modal: Thêm Mới Sinh Viên (jQuery AJAX) -->
<div class="modal fade" id="modalCreateStudent" tabindex="-1" aria-labelledby="modalCreateStudentLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="formCreateStudent">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalCreateStudentLabel">
                        <i class="bi bi-person-plus-fill me-2"></i>Thêm Mới Sinh Viên (Xử lý bằng jQuery AJAX)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="modalAlertBox" class="alert alert-danger d-none mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Mã Sinh Viên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control text-uppercase" id="inpMaSV" placeholder="VD: SV2026999" required maxlength="15" />
                            <div class="form-text">Từ 6-15 ký tự chữ và số, không trùng lặp.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="inpHoten" placeholder="VD: Nguyễn Văn An" required maxlength="100" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày Sinh <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="inpNgaySinh" required value="2005-01-01" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Giới Tính <span class="text-danger">*</span></label>
                            <select class="form-select" id="inpGioiTinh">
                                <option value="1" selected>Nam</option>
                                <option value="0">Nữ</option>
                                <option value="2">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Lớp Học <span class="text-danger">*</span></label>
                            <select class="form-select" id="inpMaLop" required>
                                <option value="">-- Chọn Lớp --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số Điện Thoại</label>
                            <input type="tel" class="form-control" id="inpSDT" placeholder="VD: 0912345678" maxlength="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Liên Hệ</label>
                            <input type="email" class="form-control" id="inpEmail" placeholder="VD: sinhvien@studentportal.edu.vn" maxlength="100" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Địa Chỉ Thường Trú</label>
                            <input type="text" class="form-control" id="inpDiaChi" placeholder="VD: 123 Cầu Giấy, Hà Nội" maxlength="250" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Trạng Thái</label>
                            <select class="form-select" id="inpTrangThai">
                                <option value="0" selected>Đang học</option>
                                <option value="1">Bảo lưu</option>
                                <option value="2">Thôi học</option>
                                <option value="3">Đã tốt nghiệp</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success px-4" id="btnSubmitCreate">
                        <i class="bi bi-check2-circle me-1"></i> Lưu Sinh Viên (jQuery AJAX)
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
        // =========================================================================
        // KHAI BÁO BIẾN TRẠNG THÁI TOÀN CỤC CHO AJAX CLIENT
        // =========================================================================
        let currentPage = 1;
        let currentPageSize = 10;
        let currentKeyword = '';
        let currentMaLop = '';
        let searchDebounceTimer = null;

        // =========================================================================
        // HÀM HELPER: GHI LOG RA MÀN HÌNH TERMINAL & TOAST NOTIFICATION
        // =========================================================================
        function appendTerminalLog(tool, message, isSuccess = true) {
            const terminal = document.getElementById('ajaxLogTerminal');
            if (!terminal) return;
            const now = new Date();
            const timeStr = now.toLocaleTimeString() + '.' + String(now.getMilliseconds()).padStart(3, '0');
            const colorClass = isSuccess ? 'text-success' : 'text-danger';
            const logItem = document.createElement('div');
            logItem.innerHTML = `<span class="text-muted">[${timeStr}]</span> <span class="badge ${isSuccess ? 'bg-primary' : 'bg-danger'}">${tool}</span> <span class="${colorClass}">${message}</span>`;
            terminal.appendChild(logItem);
            terminal.scrollTop = terminal.scrollHeight;
        }

        function showToast(type, message) {
            const container = document.getElementById('liveAlertContainer');
            if (!container) return;
            const alertId = 'alert_' + Date.now();
            const alertHtml = `
                <div id="${alertId}" class="alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show shadow-lg" role="alert">
                    <strong>${type === 'success' ? '✓ Thành công:' : '✗ Lỗi:'}</strong> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            container.insertAdjacentHTML('beforeend', alertHtml);
            setTimeout(() => {
                const el = document.getElementById(alertId);
                if (el) {
                    const bsAlert = new bootstrap.Alert(el);
                    bsAlert.close();
                }
            }, 4500);
        }

        function setAjaxStatus(text, methodBadge) {
            document.getElementById('ajaxStatusText').innerText = text;
            if (methodBadge) {
                document.getElementById('lblCurrentMethod').innerText = methodBadge;
            }
        }

        function toggleSpinner(show) {
            const spinner = document.getElementById('globalLoadingSpinner');
            if (spinner) {
                if (show) spinner.classList.remove('d-none');
                else spinner.classList.add('d-none');
            }
        }

        // =========================================================================
        // YÊU CẦU 1: UI UPDATE BẰNG JAVASCRIPT SỬ DỤNG XMLHttpRequest
        // =========================================================================
        function loadDataWithXMLHttpRequest(page, pageSize, keyword, maLop) {
            toggleSpinner(true);
            setAjaxStatus(`Đang gọi XMLHttpRequest lấy dữ liệu trang ${page}...`, 'XMLHttpRequest');
            appendTerminalLog('XMLHttpRequest', `Gửi GET /SinhVienAjax/GetPagedData?page=${page}&pageSize=${pageSize}&keyword=${keyword || ''}`);

            const startTime = performance.now();
            const xhr = new XMLHttpRequest();
            const url = `/SinhVienAjax/GetPagedData?page=${page}&pageSize=${pageSize}&keyword=${encodeURIComponent(keyword || '')}&maLop=${encodeURIComponent(maLop || '')}`;

            xhr.open('GET', url, true);
            xhr.setRequestHeader('Accept', 'application/json');

            xhr.onreadystatechange = function () {
                if (xhr.readyState === XMLHttpRequest.DONE) {
                    toggleSpinner(false);
                    const duration = Math.round(performance.now() - startTime);

                    if (xhr.status >= 200 && xhr.status < 300) {
                        try {
                            const response = JSON.parse(xhr.responseText);
                            if (response.success) {
                                // Cập nhật DOM Table bằng Javascript thuần
                                renderTableDOM(response.items);
                                // Cập nhật DOM phân trang
                                renderPaginationDOM(response.pageIndex, response.totalPages, response.totalItems);

                                document.getElementById('lblTotalRecords').innerText = response.totalItems;
                                setAjaxStatus(`Đã tải thành công ${response.items.length} bản ghi bằng XHR (${duration}ms)`, 'XMLHttpRequest');
                                appendTerminalLog('XMLHttpRequest', `Nhận JSON Status ${xhr.status} OK: ${response.totalItems} tổng bản ghi (${duration}ms)`);
                            } else {
                                showToast('error', response.message || 'Lỗi xử lý server');
                            }
                        } catch (e) {
                            showToast('error', 'Lỗi parse JSON: ' + e.message);
                            appendTerminalLog('XMLHttpRequest', 'Lỗi phân tích JSON: ' + e.message, false);
                        }
                    } else {
                        const errMsg = `Lỗi HTTP ${xhr.status}: ${xhr.statusText}`;
                        showToast('error', errMsg);
                        setAjaxStatus(errMsg, 'XMLHttpRequest');
                        appendTerminalLog('XMLHttpRequest', errMsg, false);
                    }
                }
            };

            xhr.onerror = function () {
                toggleSpinner(false);
                showToast('error', 'Lỗi mạng (Network Error) khi thực hiện XMLHttpRequest');
                appendTerminalLog('XMLHttpRequest', 'Network Error - Không thể kết nối máy chủ', false);
            };

            xhr.send();
        }

        // =========================================================================
        // HÀM RENDER DOM BẢNG DỮ LIỆU BẰNG JAVASCRIPT (DOM MANIPULATION)
        // =========================================================================
        function renderTableDOM(items) {
            const tbody = document.getElementById('studentTableBody');
            tbody.innerHTML = ''; // Xóa sạch dữ liệu cũ

            if (!items || items.length === 0) {
                const emptyRow = document.createElement('tr');
                emptyRow.innerHTML = `
                    <td colspan="8" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        Không tìm thấy sinh viên nào phù hợp với điều kiện tìm kiếm.
                    </td>`;
                tbody.appendChild(emptyRow);
                return;
            }

            items.forEach(sv => {
                const tr = document.createElement('tr');
                tr.id = `row_sv_${sv.maSV}`;

                // Tạo badge trạng thái
                let badgeClass = 'bg-success';
                if (sv.trangThai === 1) badgeClass = 'bg-warning text-dark';
                else if (sv.trangThai === 2) badgeClass = 'bg-danger';
                else if (sv.trangThai === 3) badgeClass = 'bg-info text-dark';

                tr.innerHTML = `
                    <td class="ps-3"><strong class="text-primary">${sv.maSV}</strong></td>
                    <td>
                        <div class="fw-semibold text-dark">${sv.hoTen}</div>
                        <small class="text-muted">${sv.diaChi !== 'Chưa có' ? sv.diaChi : ''}</small>
                    </td>
                    <td>${sv.ngaySinhFormatted}</td>
                    <td>${sv.gioiTinhText}</td>
                    <td><span class="badge bg-light text-dark border">${sv.tenLop}</span></td>
                    <td>
                        <div class="small"><i class="bi bi-envelope text-muted me-1"></i>${sv.email}</div>
                        <div class="small"><i class="bi bi-telephone text-muted me-1"></i>${sv.sdt}</div>
                    </td>
                    <td><span class="badge ${badgeClass}">${sv.trangThaiText}</span></td>
                    <td class="text-center pe-3">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-student"
                                data-masv="${sv.maSV}" data-hoten="${sv.hoTen}" title="Xóa sinh viên (jQuery AJAX)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // =========================================================================
        // YÊU CẦU 3: PAGINATION DÙNG EF CORE SKIP/TAKE VÀ AJAX LOAD TRANG
        // =========================================================================
        function renderPaginationDOM(pageIndex, totalPages, totalItems) {
            currentPage = pageIndex;
            const container = document.getElementById('paginationContainer');
            container.innerHTML = '';

            const startItem = totalItems === 0 ? 0 : (pageIndex - 1) * currentPageSize + 1;
            const endItem = Math.min(pageIndex * currentPageSize, totalItems);

            document.getElementById('lblPagingInfo').innerText = `Hiển thị ${startItem} - ${endItem} trong tổng số ${totalItems} sinh viên`;
            document.getElementById('lblPaginationSummary').innerText = `Trang ${pageIndex} / ${totalPages || 1}`;

            if (totalPages <= 1) return;

            // Nút Previous
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${pageIndex <= 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<a class="page-link" href="#" data-page="${pageIndex - 1}"><i class="bi bi-chevron-left"></i> Trước</a>`;
            container.appendChild(prevLi);

            // Các nút số trang
            const startPage = Math.max(1, pageIndex - 2);
            const endPage = Math.min(totalPages, pageIndex + 2);

            if (startPage > 1) {
                const firstLi = document.createElement('li');
                firstLi.className = 'page-item';
                firstLi.innerHTML = `<a class="page-link" href="#" data-page="1">1</a>`;
                container.appendChild(firstLi);
                if (startPage > 2) {
                    const dotsLi = document.createElement('li');
                    dotsLi.className = 'page-item disabled';
                    dotsLi.innerHTML = `<span class="page-link">...</span>`;
                    container.appendChild(dotsLi);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                const pageLi = document.createElement('li');
                pageLi.className = `page-item ${i === pageIndex ? 'active' : ''}`;
                pageLi.innerHTML = `<a class="page-link" href="#" data-page="${i}">${i}</a>`;
                container.appendChild(pageLi);
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const dotsLi = document.createElement('li');
                    dotsLi.className = 'page-item disabled';
                    dotsLi.innerHTML = `<span class="page-link">...</span>`;
                    container.appendChild(dotsLi);
                }
                const lastLi = document.createElement('li');
                lastLi.className = 'page-item';
                lastLi.innerHTML = `<a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>`;
                container.appendChild(lastLi);
            }

            // Nút Next
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${pageIndex >= totalPages ? 'disabled' : ''}`;
            nextLi.innerHTML = `<a class="page-link" href="#" data-page="${pageIndex + 1}">Sau <i class="bi bi-chevron-right"></i></a>`;
            container.appendChild(nextLi);

            // Gán sự kiện click cho các thẻ phân trang
            container.querySelectorAll('a.page-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetPage = parseInt(this.getAttribute('data-page'));
                    if (targetPage && targetPage !== currentPage && targetPage >= 1 && targetPage <= totalPages) {
                        appendTerminalLog('Pagination', `Người dùng chuyển sang trang ${targetPage} (Gọi AJAX Skip/Take)`);
                        loadDataWithXMLHttpRequest(targetPage, currentPageSize, currentKeyword, currentMaLop);
                    }
                });
            });
        }

        // =========================================================================
        // YÊU CẦU 4: AJAX SEARCH DÙNG fetch() GỌI API & RENDER DỮ LIỆU (DEBOUNCE)
        // =========================================================================
        async function searchWithFetch(keyword) {
            toggleSpinner(true);
            setAjaxStatus(`Đang gọi Fetch API tìm kiếm '${keyword}'...`, 'Fetch API');
            appendTerminalLog('Fetch API', `fetch('/SinhVienAjax/GetPagedData?page=1&keyword=${encodeURIComponent(keyword)}')`);

            const startTime = performance.now();
            try {
                const response = await fetch(`/SinhVienAjax/GetPagedData?page=1&pageSize=${currentPageSize}&keyword=${encodeURIComponent(keyword)}&maLop=${encodeURIComponent(currentMaLop)}`, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                toggleSpinner(false);
                const duration = Math.round(performance.now() - startTime);

                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }

                const data = await response.json();
                if (data.success) {
                    renderTableDOM(data.items);
                    renderPaginationDOM(data.pageIndex, data.totalPages, data.totalItems);
                    document.getElementById('lblTotalRecords').innerText = data.totalItems;

                    setAjaxStatus(`Tìm kiếm thành công với Fetch API (${duration}ms) - Khớp ${data.totalItems} kết quả`, 'Fetch API');
                    appendTerminalLog('Fetch API', `Phản hồi 200 OK: Tìm thấy ${data.totalItems} kết quả (${duration}ms)`);
                } else {
                    showToast('error', data.message || 'Lỗi tìm kiếm');
                }
            } catch (err) {
                toggleSpinner(false);
                const errMsg = 'Lỗi Fetch API: ' + err.message;
                showToast('error', errMsg);
                setAjaxStatus(errMsg, 'Fetch API');
                appendTerminalLog('Fetch API', errMsg, false);
            }
        }

        // =========================================================================
        // NẠP DANH MỤC LỚP HỌC VÀO CÁC DROPDOWN (BẰNG FETCH API)
        // =========================================================================
        async function loadLopDropdowns() {
            try {
                const res = await fetch('/SinhVienAjax/GetLopOptions');
                if (res.ok) {
                    const lops = await res.json();
                    const filterSelect = document.getElementById('selFilterLop');
                    const modalSelect = document.getElementById('inpMaLop');

                    lops.forEach(lop => {
                        // Thêm vào filter
                        const optFilter = document.createElement('option');
                        optFilter.value = lop.maLop;
                        optFilter.textContent = lop.tenLop;
                        filterSelect.appendChild(optFilter);

                        // Thêm vào modal
                        const optModal = document.createElement('option');
                        optModal.value = lop.maLop;
                        optModal.textContent = lop.tenLop;
                        modalSelect.appendChild(optModal);
                    });
                }
            } catch (e) {
                console.error("Lỗi nạp dropdown lớp: ", e);
            }
        }

        // =========================================================================
        // YÊU CẦU 2: CRUD AJAX BẰNG jQuery AJAX (CREATE & DELETE)
        // =========================================================================
        $(document).ready(function () {
            // Nạp danh mục lớp
            loadLopDropdowns();

            // Khởi tạo bảng dữ liệu ban đầu bằng XMLHttpRequest (Mục 1)
            loadDataWithXMLHttpRequest(currentPage, currentPageSize, currentKeyword, currentMaLop);

            // Nút tải lại bằng XMLHttpRequest thuần
            $('#btnReloadXHR').on('click', function () {
                loadDataWithXMLHttpRequest(1, currentPageSize, currentKeyword, currentMaLop);
            });

            // Sự kiện tìm kiếm có Debounce 300ms (Fetch API - Mục 4)
            $('#txtKeywordSearch').on('input', function () {
                const val = $(this).val();
                currentKeyword = val;
                clearTimeout(searchDebounceTimer);
                searchDebounceTimer = setTimeout(function () {
                    searchWithFetch(currentKeyword);
                }, 300);
            });

            // Nút xóa tìm kiếm
            $('#btnClearSearch').on('click', function () {
                $('#txtKeywordSearch').val('');
                currentKeyword = '';
                searchWithFetch('');
            });

            // Lọc theo lớp
            $('#selFilterLop').on('change', function () {
                currentMaLop = $(this).val();
                loadDataWithXMLHttpRequest(1, currentPageSize, currentKeyword, currentMaLop);
            });

            // Thay đổi PageSize (Skip/Take)
            $('#selPageSize').on('change', function () {
                currentPageSize = parseInt($(this).val());
                loadDataWithXMLHttpRequest(1, currentPageSize, currentKeyword, currentMaLop);
            });

            // Xóa Terminal Log
            $('#btnClearLog').on('click', function () {
                $('#ajaxLogTerminal').html('<div class="text-info">[HỆ THỐNG] Đã làm trống nhật ký log.</div>');
            });

            // ---------------------------------------------------------------------
            // 2.1 CREATE SINH VIÊN BẰNG jQuery AJAX
            // ---------------------------------------------------------------------
            $('#formCreateStudent').on('submit', function (e) {
                e.preventDefault();

                const payload = {
                    maSV: $('#inpMaSV').val().trim(),
                    hoTen: $('#inpHoten').val().trim(),
                    ngaySinh: $('#inpNgaySinh').val(),
                    gioiTinh: parseInt($('#inpGioiTinh').val()),
                    maLop: $('#inpMaLop').val(),
                    sdt: $('#inpSDT').val().trim(),
                    email: $('#inpEmail').val().trim(),
                    diaChi: $('#inpDiaChi').val().trim(),
                    trangThai: parseInt($('#inpTrangThai').val())
                };

                const $submitBtn = $('#btnSubmitCreate');
                const originalBtnHtml = $submitBtn.html();

                appendTerminalLog('jQuery AJAX', `Gửi POST /SinhVienAjax/Create với Payload: MaSV=${payload.maSV}, HoTen=${payload.hoTen}`);
                setAjaxStatus('Đang gửi dữ liệu tạo mới qua jQuery AJAX...', 'jQuery AJAX');

                $.ajax({
                    url: '/SinhVienAjax/Create',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(payload),
                    beforeSend: function () {
                        toggleSpinner(true);
                        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');
                        $('#modalAlertBox').addClass('d-none').empty();
                    },
                    success: function (response) {
                        toggleSpinner(false);
                        if (response.success) {
                            // Đóng modal
                            const modalEl = document.getElementById('modalCreateStudent');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();

                            // Reset form
                            $('#formCreateStudent')[0].reset();

                            showToast('success', response.message);
                            appendTerminalLog('jQuery AJAX', `Thành công (HTTP 200 OK): Đã thêm mới sinh viên [${response.data.maSV}]`);
                            setAjaxStatus(`Thêm mới thành công sinh viên ${response.data.maSV}`, 'jQuery AJAX');

                            // Nạp lại danh sách để đồng bộ thứ tự sắp xếp và phân trang
                            loadDataWithXMLHttpRequest(1, currentPageSize, '', '');
                        }
                    },
                    error: function (xhr) {
                        toggleSpinner(false);
                        const res = xhr.responseJSON;
                        let errMsg = res && res.message ? res.message : `Lỗi ${xhr.status}: ${xhr.statusText}`;

                        if (res && res.errors && res.errors.length > 0) {
                            errMsg += '<ul class="mb-0 mt-1">' + res.errors.map(e => `<li>${e}</li>`).join('') + '</ul>';
                        }

                        $('#modalAlertBox').removeClass('d-none').html(errMsg);
                        appendTerminalLog('jQuery AJAX', `Thất bại (HTTP ${xhr.status}): ${res?.message || xhr.statusText}`, false);
                        setAjaxStatus(`Lỗi khi tạo mới: ${res?.message || xhr.statusText}`, 'jQuery AJAX');
                    },
                    complete: function () {
                        $submitBtn.prop('disabled', false).html(originalBtnHtml);
                    }
                });
            });

            // ---------------------------------------------------------------------
            // 2.2 DELETE SINH VIÊN BẰNG jQuery AJAX
            // ---------------------------------------------------------------------
            $(document).on('click', '.btn-delete-student', function () {
                const maSV = $(this).data('masv');
                const hoTen = $(this).data('hoten');

                if (!confirm(`Bạn có chắc chắn muốn xóa sinh viên: [${maSV}] - ${hoTen}?\n(Hệ thống sẽ thực hiện Soft Delete và cập nhật giao diện ngay lập tức)`)) {
                    return;
                }

                const $row = $(`#row_sv_${maSV}`);
                appendTerminalLog('jQuery AJAX', `Gửi POST /SinhVienAjax/Delete với MaSV=${maSV}`);
                setAjaxStatus(`Đang thực hiện xóa sinh viên ${maSV}...`, 'jQuery AJAX');

                $.ajax({
                    url: '/SinhVienAjax/Delete',
                    type: 'POST',
                    data: { maSV: maSV },
                    beforeSend: function () {
                        toggleSpinner(true);
                        $row.css('opacity', '0.4').css('background-color', '#ffe6e6');
                    },
                    success: function (response) {
                        toggleSpinner(false);
                        if (response.success) {
                            showToast('success', response.message);
                            appendTerminalLog('jQuery AJAX', `Xóa thành công sinh viên ${maSV} (HTTP 200 OK)`);
                            setAjaxStatus(`Đã xóa thành công sinh viên ${maSV}`, 'jQuery AJAX');

                            // Xóa phần tử DOM với hiệu ứng mượt mà (FadeOut)
                            $row.fadeOut(400, function () {
                                $(this).remove();
                                // Giảm số lượng tổng trên UI
                                const curTotal = parseInt($('#lblTotalRecords').text()) || 0;
                                if (curTotal > 0) {
                                    $('#lblTotalRecords').text(curTotal - 1);
                                }
                            });
                        }
                    },
                    error: function (xhr) {
                        toggleSpinner(false);
                        $row.css('opacity', '1').css('background-color', '');
                        const res = xhr.responseJSON;
                        const errMsg = res?.message || `Lỗi HTTP ${xhr.status}: ${xhr.statusText}`;
                        showToast('error', errMsg);
                        appendTerminalLog('jQuery AJAX', `Lỗi xóa sinh viên ${maSV}: ${errMsg}`, false);
                        setAjaxStatus(`Lỗi khi xóa: ${errMsg}`, 'jQuery AJAX');
                    }
                });
            });
        });
    </script>
}

